# Platform API URLs and published-post URL templates are configurable here.
# Mastodon: create an application token with write:statuses permission.
MASTODON_API_URL=https://mastodon.social/api/v1/statuses
MASTODON_ACCESS_TOKEN=

# Bluesky app password (do not use your account password).
BLUESKY_XRPC_URL=https://bsky.social/xrpc
BLUESKY_POST_URL_TEMPLATE=https://bsky.app/profile/{handle}/post/{rkey}
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# X API v2 user access token with tweet.write and users.read scopes.
X_API_URL=https://api.x.com/2/tweets
X_POST_URL_TEMPLATE=https://x.com/{username}/status/{post_id}
X_ACCESS_TOKEN=
X_USERNAME=

# Reddit OAuth access token for a user authorized to submit to this subreddit.
REDDIT_SUBMIT_URL=https://oauth.reddit.com/api/submit
REDDIT_ACCESS_TOKEN=
REDDIT_SUBREDDIT=
REDDIT_TITLE=Update

# Tumblr OAuth 1.0a credentials and blog hostname (e.g. example.tumblr.com).
TUMBLR_POST_URL_TEMPLATE=https://api.tumblr.com/v2/blog/{blog_identifier}/post
TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=
TUMBLR_TOKEN=
TUMBLR_TOKEN_SECRET=
TUMBLR_BLOG_IDENTIFIER=
